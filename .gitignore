*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# =============================================================================
# Arma Reforger — vanilla-data/ klasörü kuralları
# =============================================================================
# Binary varlıklar (çok büyük, telif hakkı, AI için gereksiz) → YOK
vanilla-data/ArmaReforger/**/*.xob
vanilla-data/ArmaReforger/**/*.edds
vanilla-data/ArmaReforger/**/*.emat
vanilla-data/ArmaReforger/**/*.pak
vanilla-data/ArmaReforger/**/*.pbo
vanilla-data/ArmaReforger/**/*.png
vanilla-data/ArmaReforger/**/*.jpg
vanilla-data/ArmaReforger/**/*.jpeg
vanilla-data/ArmaReforger/**/*.bmp
